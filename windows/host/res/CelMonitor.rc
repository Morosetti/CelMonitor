// Icons and version information for CelMonitor.exe (icons generated by make-icon.ps1).
#include <winver.h>

1 ICON "CelMonitor.ico"       // exe, taskbar, installer; tray and window while streaming
2 ICON "CelMonitorIdle.ico"   // tray and window while no phone is streaming

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "CelMonitor"
            VALUE "FileDescription", "CelMonitor - celular Android como monitor via USB"
            VALUE "FileVersion", "0.2.0"
            VALUE "ProductName", "CelMonitor"
            VALUE "ProductVersion", "0.2.0"
            VALUE "OriginalFilename", "CelMonitor.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
