// Icon (id 1: window, tray, installer) and version information for CelMonitor.exe.
#include <winver.h>

1 ICON "CelMonitor.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "CompanyName", "CelMonitor"
            VALUE "FileDescription", "CelMonitor - celular Android como monitor via USB"
            VALUE "FileVersion", "0.2.0"
            VALUE "ProductName", "CelMonitor"
            VALUE "ProductVersion", "0.2.0"
            VALUE "OriginalFilename", "CelMonitor.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0416, 1200
    END
END
